---
import Base from "../layouts/Base.astro";
import { site } from "../site";
import { entries } from "../db";
import { clouds, whale, birds, stars } from "../sky";

const tree = [
  { href: "/search/", name: "search/", note: `${entries.length} security features, searchable in plain words` },
  { href: "/products/", name: "products/", note: "checklist, rules pack and launch review" },
  { href: "/docs/", name: "docs/", note: "how this site is built and secured" },
  { href: "/changelog/", name: "changelog/", note: "every change, in plain English" },
];
---

<Base title={`${site.brand.name} — security, made simple`} description="Small, useful security tools for people without a security team. Start with the free, searchable security feature database.">
  <section class="landing">
    <div class="sky" aria-hidden="true">
      {stars.map((s) => <span class="star">{s}</span>)}
      {clouds.map((c, i) => <pre class={`cloud cloud-${i + 1}`}>{c}</pre>)}
      <div class="flyer birds">{birds.map((f) => <pre>{f}</pre>)}</div>
      <div class="flyer whale">{whale.map((f) => <pre>{f}</pre>)}</div>
    </div>

    <div class="landing-inner">
      <div class="landing-card glass stagger">
        <p class="eyebrow">{site.brand.name} · {site.brand.pronounce}</p>
        <h1>{site.headline.split("\n").map((line) => <span>{line}</span>)}</h1>
        <p class="lead">Small, useful security tools for people without a security team.</p>
        <div class="ctas">
          <a class="pill glass glass-tint" href="/search/">Search {entries.length} security features</a>
          <a class="pill glass" href="/products/">See products</a>
        </div>
      </div>

      <nav class="tree reveal" aria-label="What's on this site">
        <p class="tree-root">kamllistos.com/</p>
        <ul>
          {tree.map((t) => (
            <li><a href={t.href}>{t.name}</a> <span>{t.note}</span></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</Base>
