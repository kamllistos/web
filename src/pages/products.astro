---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base title={`Products — ${site.brand.name}`}>
  <section class="hero stagger">
    <p class="eyebrow">Products</p>
    <h1>Built under<span>{site.brand.name}.</span></h1>
    <p class="lead">Small, useful security tools for people without a security team. Start with the free security feature database, then grab the checklist, the rules pack or a review.</p>
  </section>

  <section class="band">
    <div class="products">
      <a class="product-card live reveal" href="/">
        <span class="product-badge live">Live</span>
        <h3>{site.brand.product}</h3>
        <p>A searchable database of security features to add to a web app — what each one stops, how to build it, a prompt for your AI tool, and how to check it works.</p>
        <span class="more">Open it</span>
      </a>

      <a class="product-card live reveal" href="https://camtoan.gumroad.com/l/launch-checklist" rel="noopener">
        <span class="product-badge live">Free</span>
        <h3>Launch Security Checklist</h3>
        <p>The 31 must-have features to check before you ship, each with a quick test and a prompt for your AI tool.</p>
        <span class="more">Get it on Gumroad</span>
      </a>

      <a class="product-card live reveal" href="https://camtoan.gumroad.com/l/agent-rules-pack" rel="noopener">
        <span class="product-badge live">$29</span>
        <h3>Agent Rules Pack</h3>
        <p>All 70 features as rules for Cursor, Claude Code and Codex, so your agent applies them while it codes.</p>
        <span class="more">Get it on Gumroad</span>
      </a>

      <a class="product-card live reveal" href="https://camtoan.gumroad.com/l/launch-review" rel="noopener">
        <span class="product-badge live">$149</span>
        <h3>Launch-Readiness Review</h3>
        <p>A person checks your app against the 31 must-haves and sends a written report with fixes in 5 business days.</p>
        <span class="more">Book on Gumroad</span>
      </a>
    </div>
  </section>

  <section class="band band-gray">
    <div class="narrow center reveal">
      <p class="eyebrow">The name</p>
      <h2>Why "{site.brand.name}"?</h2>
      <p class="body-lg">{site.brand.meaning}</p>
      <div class="ctas">
        <a class="pill" href={`mailto:${site.email}?subject=${encodeURIComponent("Product idea for " + site.brand.name)}`}>Suggest a tool</a>
        <a class="more" href="https://camtoan.me">About me</a>
      </div>
    </div>
  </section>
</Base>
