---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../site";

const pages = (await getCollection("legal")).sort((a, b) => a.data.order - b.data.order);
const label = { "in-effect": "In effect", standby: "Standby" };
---

<Base title={`Legal & privacy — ${site.name}`}>
  <section class="hero stagger">
    <p class="eyebrow">Legal & privacy</p>
    <h1>The rules,<span>in plain English.</span></h1>
    <p class="lead">This site collects almost nothing: no accounts, no forms, no tracking. Each page says what's true today and what would have to happen before that changes. <b>In effect</b> applies now. <b>Standby</b> is a plan that's ready for when it's needed.</p>
  </section>
  <section class="band band-gray">
    <div class="tiles">
      {pages.map((p) => (
        <a class="tile tile-link reveal" href={`/legal/${p.id}/`}>
          <span class={`status status-${p.data.status}`}>{label[p.data.status]}</span>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
        </a>
      ))}
    </div>
    <p class="center">Questions? <a href={`mailto:${site.email}`}>{site.email}</a></p>
  </section>
</Base>
