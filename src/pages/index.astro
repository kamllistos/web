---
import Base from "../layouts/Base.astro";
import { site } from "../site";
import { categories, concepts } from "../features";

// Shuffle a copy for the marquee so the scroll order varies per build.
const marquee = [...concepts].sort(() => Math.random() - 0.5);
---

<Base title={`Feature lookup — ${site.name}`}>
  <div class="marquee" aria-label="Security concepts">
    <div class="marquee-track">
      {marquee.map((c) => (
        <a class="marquee-item" href={`/glossary/${c.path}/`}>{c.cat.icon} {c.name}</a>
      ))}
      {marquee.map((c) => (
        <a class="marquee-item" href={`/glossary/${c.path}/`} aria-hidden="true" tabindex="-1">{c.cat.icon} {c.name}</a>
      ))}
    </div>
  </div>

  <section class="hero stagger">
    <p class="eyebrow">feature-lookup · interactive glossary</p>
    <h1><span>Name that</span><span>security thing.</span></h1>
    <p class="lead">Every security term, explained in plain English. Pick an area, search for anything you've heard of, or just start clicking.</p>
  </section>

  <section class="band band-gray">
    <div class="search-wrap">
      <label for="feature-search" class="sr-only">Search security concepts</label>
      <div class="combobox">
        <input
          id="feature-search"
          class="search"
          type="text"
          role="combobox"
          placeholder="Search: MFA, phishing, backups, SIEM…"
          autocomplete="off"
          spellcheck="false"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="search-listbox"
        />
        <ul id="search-listbox" class="combo-list" role="listbox" aria-label="Matching concepts" hidden></ul>
      </div>
      <p id="search-meta" class="search-meta center" aria-live="polite">Press <kbd>/</kbd> to search · <kbd>↑</kbd><kbd>↓</kbd> to pick · <kbd>Enter</kbd> to open</p>
    </div>
    <div class="chips" role="group" aria-label="Choose an area">
      <button class="chip" type="button" data-filter="all" aria-pressed="true">All</button>
      {categories.map((c) => <button class="chip" type="button" data-filter={c.id} aria-pressed="false">{c.icon} {c.short}</button>)}
    </div>
  </section>

  <section id="results" class="band">
    {categories.map((c) => (
      <header class="cat-field" data-category={c.id} hidden>
        <span class="cat-icon" aria-hidden="true">{c.icon}</span>
        <h2>{c.name}</h2>
        <p class="cat-tagline">{c.tagline}</p>
        <p>{c.summary}</p>
        <p class="cat-why">{c.why}</p>
        {c.examples.length > 0 && <p class="cat-examples"><b>Examples:</b> {c.examples.join(", ")}</p>}
      </header>
    ))}

    <div class="concepts">
      {concepts.map((c) => (
        <a
          class="concept"
          href={`/glossary/${c.path}/`}
          data-category={c.cat.id}
          data-name={c.name.toLowerCase()}
          data-text={`${c.name} ${c.desc} ${c.cat.name} ${c.cat.short}`.toLowerCase()}
        >
          <span class="concept-name">{c.name}</span>
          <span class="concept-cat">{c.cat.icon} {c.cat.short}</span>
          <span class="concept-desc">{c.desc}</span>
          <span class="concept-go" aria-hidden="true">Learn more →</span>
        </a>
      ))}
    </div>
    <div id="no-results" class="no-results" hidden>
      <p>No matches. Try a simpler word, or <a href={`mailto:${site.email}`}>ask me</a>.</p>
    </div>
  </section>

  <script is:inline src="/glossary.js" defer></script>
</Base>
