---
import Base from "../layouts/Base.astro";
import { site } from "../site";
import { getAllPosts, formatDate } from "../posts";
import "../demos.css";

const latest = (await getAllPosts()).slice(0, 3);
const m365 = site.packages.find((p) => p.id === "m365-health-check");
const docs = site.packages.find((p) => p.id === "it-documentation");
---

<Base title={`Services — ${site.name}`}>
  <section class="hero stagger">
    <p class="eyebrow">{site.role}</p>
    <h1>What I can do<span>for you.</span></h1>
    <p class="lead">{site.tagline}</p>
  </section>

  <section class="band">
    <div class="narrow center reveal">
      <h2>Narrow on purpose.</h2>
      <p class="body-lg">I'm not a do-everything cybersecurity consultant. I help small businesses get the Microsoft 365 they already pay for set up safely — and write down how their IT actually works. Two clear packages, fixed prices, plain English.</p>
    </div>
  </section>

  {m365 && (
    <section id={m365.id} class="band band-gray">
      <div class="package reveal">
        <p class="eyebrow">Package 1</p>
        <h2>{m365.name}</h2>
        <p class="pkg-tagline body-lg">{m365.tagline}</p>
        <p class="pkg-for"><b>For:</b> {m365.forWho}</p>
        <div class="delivers">
          {m365.delivers.map((d) => (
            <div class="deliver">
              <h3>{d.title}</h3>
              <ul>{d.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
        <p class="pkg-report">{m365.report}</p>
        <div class="sample">
          <p class="sample-kicker">What a finding looks like</p>
          <p class="sample-score">Secure Score: <b>{site.sampleReport.score}</b></p>
          <ul class="sample-rows">
            {site.sampleReport.rows.map((r) => (
              <li class={`sr-${r.level.split(" ")[0].toLowerCase()}`}><b>{r.level}:</b> {r.text}</li>
            ))}
          </ul>
          <p class="sample-quick"><b>Quick wins:</b> {site.sampleReport.quickWins.join(" · ")}</p>
        </div>
        <div class="tiers">
          {m365.tiers.map((t) => (
            <div class={`tier${t.featured ? " featured" : ""}`}>
              {t.featured && <span class="tier-badge">Most popular</span>}
              <h4 class="tier-name">{t.name}</h4>
              <p class="tier-price">{t.price} <span>CAD</span></p>
              <ul class="tier-inc">{t.includes.map((x) => <li>{x}</li>)}</ul>
              <a class="pill" href={`mailto:${site.email}?subject=${encodeURIComponent(m365.name + " — " + t.name)}`}>Enquire</a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="band">
    <div class="narrow center reveal">
      <h2>See what I look for.</h2>
      <p class="body-lg">This is the heart of the health check: enabling a handful of boring controls. Flip the switches and watch the risk drop.</p>
    </div>
    <div id="demo-infosec" class="demo">
      <div class="demo-head"><span class="demo-kicker">Live demo</span><strong>Harden this business</strong></div>
      <div class="meter-wrap">
        <div class="meter-label"><span>RISK</span><span class="meter-num" id="infosec-num" aria-live="polite">WIDE OPEN · 100%</span></div>
        <div class="meter"><div class="meter-fill risk bad" id="infosec-meter"></div></div>
      </div>
      <div class="hardens">
        <button type="button" class="harden" data-cut="25" aria-pressed="false">
          <span class="harden-name">MFA on all logins</span>
          <span class="harden-benefit">A stolen password alone won't get in.</span>
          <span class="harden-cut">−25</span>
        </button>
        <button type="button" class="harden" data-cut="20" aria-pressed="false">
          <span class="harden-name">Keep everything updated</span>
          <span class="harden-benefit">Closes the holes hackers already know about.</span>
          <span class="harden-cut">−20</span>
        </button>
        <button type="button" class="harden" data-cut="20" aria-pressed="false">
          <span class="harden-name">Daily backups (offline copy)</span>
          <span class="harden-benefit">Ransomware? Restore and move on.</span>
          <span class="harden-cut">−20</span>
        </button>
        <button type="button" class="harden" data-cut="15" aria-pressed="false">
          <span class="harden-name">Train staff to spot phishing</span>
          <span class="harden-benefit">Your people become the firewall.</span>
          <span class="harden-cut">−15</span>
        </button>
        <button type="button" class="harden" data-cut="10" aria-pressed="false">
          <span class="harden-name">Email authentication (SPF/DKIM/DMARC)</span>
          <span class="harden-benefit">Stops crooks faking emails as "you."</span>
          <span class="harden-cut">−10</span>
        </button>
        <button type="button" class="harden" data-cut="5" aria-pressed="false">
          <span class="harden-name">Firewall + least-privilege access</span>
          <span class="harden-benefit">Fewer doors, fewer keys floating around.</span>
          <span class="harden-cut">−5</span>
        </button>
      </div>
      <div class="demo-controls">
        <button type="button" class="demo-btn ghost" id="infosec-reset">Reset</button>
      </div>
      <p class="demo-hint" id="infosec-hint" aria-live="polite">Flip the switches. Watch your risk drop. (It never hits zero — nobody's bulletproof.)</p>
    </div>
  </section>

  {docs && (
    <section id={docs.id} class="band band-gray">
      <div class="package reveal">
        <p class="eyebrow">Package 2</p>
        <h2>{docs.name}</h2>
        <p class="pkg-tagline body-lg">{docs.tagline}</p>
        <p class="pkg-for"><b>For:</b> {docs.forWho}</p>
        <div class="delivers">
          {docs.delivers.map((d) => (
            <div class="deliver">
              <h3>{d.title}</h3>
              <ul>{d.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
        <div class="tiers">
          {docs.tiers.map((t) => (
            <div class={`tier${t.featured ? " featured" : ""}`}>
              {t.featured && <span class="tier-badge">Most popular</span>}
              <h4 class="tier-name">{t.name}</h4>
              <p class="tier-price">{t.price} <span>CAD</span></p>
              <ul class="tier-inc">{t.includes.map((x) => <li>{x}</li>)}</ul>
              <a class="pill" href={`mailto:${site.email}?subject=${encodeURIComponent(docs.name + " — " + t.name)}`}>Enquire</a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="band">
    <div class="narrow center reveal retainer">
      <p class="eyebrow">Ongoing</p>
      <h2>{site.retainer.name}</h2>
      <p class="body-lg">{site.retainer.tagline}</p>
      <p class="tier-price">{site.retainer.price}</p>
      <ul class="tier-inc retainer-inc">{site.retainer.includes.map((x) => <li>{x}</li>)}</ul>
      <div class="ctas"><a class="pill" href={`mailto:${site.email}?subject=${encodeURIComponent(site.retainer.name)}`}>Ask about monthly</a></div>
    </div>
  </section>

  <section class="band band-dark">
    <div class="narrow center reveal">
      <h2>What I don't do.</h2>
      <p class="body-lg">Honesty up front — these need a bigger team or a dedicated provider, and I'll happily point you to one.</p>
      <ul class="not-list">{site.notPromising.map((n) => <li>{n}</li>)}</ul>
    </div>
  </section>

  <section class="band">
    <h2 class="center reveal">How it works.</h2>
    <ol class="steps">
      {site.process.map((p) => (
        <li class="step reveal">
          <span class="step-num">{p.step}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="band band-gray">
    <div class="narrow center reveal">
      <h2>Want to see security ideas in action?</h2>
      <p class="body-lg">Two more little demos — just for fun. Poke at them; they explain the ideas better than I can.</p>
    </div>
    <div id="demo-ops" class="demo">
      <div class="demo-head"><span class="demo-kicker">Reliability</span><strong>Your fleet</strong></div>
      <div class="meter-wrap">
        <div class="meter-label"><span>UPTIME</span><span class="meter-num" id="ops-uptime" aria-live="polite">100%</span></div>
        <div class="meter"><div class="meter-fill ok" id="ops-meter"></div></div>
        <p class="meter-sub">SLO target: 99%</p>
      </div>
      <div class="servers" id="ops-servers" aria-label="Your servers"></div>
      <div class="demo-controls">
        <button type="button" class="demo-btn" id="ops-scale">+ Scale up</button>
        <button type="button" class="demo-btn toggle" id="ops-heal" aria-pressed="false">Auto-heal: Off</button>
        <button type="button" class="demo-btn ghost" id="ops-reset">Reset</button>
      </div>
      <p class="demo-hint" id="ops-hint" aria-live="polite">Servers break. Click a red one to heal it, or turn on auto-heal. The goal isn't zero failures — it's recovering fast enough to stay above target.</p>
    </div>
    <div id="demo-devops" class="demo">
      <div class="demo-head"><span class="demo-kicker">Automation</span><strong>Ship it! pipeline</strong></div>
      <div class="pipeline" id="devops-pipeline">
        <div class="stage idle" data-stage="commit"><span class="stage-dot" aria-hidden="true"></span><span class="stage-name">Commit</span><span class="stage-note"></span></div>
        <div class="stage idle" data-stage="build"><span class="stage-dot" aria-hidden="true"></span><span class="stage-name">Build</span><span class="stage-note"></span></div>
        <div class="stage idle" data-stage="test"><span class="stage-dot" aria-hidden="true"></span><span class="stage-name">Test</span><span class="stage-note"></span></div>
        <div class="stage idle" data-stage="scan"><span class="stage-dot" aria-hidden="true"></span><span class="stage-name">Security scan</span><span class="stage-note"></span></div>
        <div class="stage idle" data-stage="deploy"><span class="stage-dot" aria-hidden="true"></span><span class="stage-name">Deploy</span><span class="stage-note"></span></div>
      </div>
      <div class="demo-controls">
        <button type="button" class="demo-btn" id="devops-run">▶ Run pipeline</button>
        <button type="button" class="demo-btn toggle" id="devops-bug" aria-pressed="true">🐞 Sneak in a bug: On</button>
      </div>
      <p class="demo-hint" id="devops-strip" aria-live="polite">Your change is ready. Hit Run to ship it.</p>
    </div>
  </section>

  <section id="project" class="band band-dark">
    <div class="narrow center reveal">
      <p class="eyebrow">Project</p>
      <h2>{site.project.title}.<br />Hardened by design.</h2>
      <p class="body-lg">{site.project.text}</p>
      <div class="checks">
        {site.project.checks.map((c) => <a class="more" href={c.url} rel="noopener noreferrer">{c.label}</a>)}
      </div>
    </div>
  </section>

  <section class="band band-gray">
    <h2 class="center reveal">Latest writing.</h2>
    <div class="tiles">
      {latest.map((p) => (
        <a class="tile tile-link reveal" href={p.url} rel={p.external ? "noopener noreferrer" : undefined}>
          <span class="eyebrow">{formatDate(p.date)}{p.external && " · Substack ↗"}</span>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
        </a>
      ))}
    </div>
    <p class="center"><a class="more" href="/blog/">All posts</a></p>
  </section>

  <section class="band">
    <div class="narrow center reveal">
      <h2>Ready when you are.</h2>
      <p class="body-lg">Tell me briefly what you have and I'll reply within a couple of days.</p>
      <div class="ctas">
        <a class="pill" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="more" href="https://camtoan.me">More about me</a>
      </div>
    </div>
  </section>
  <script is:inline src="/demos.js" defer></script>
</Base>
